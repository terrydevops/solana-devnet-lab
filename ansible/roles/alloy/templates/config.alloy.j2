// {{ ansible_managed }}
// Two sources on {{ inventory_hostname }}: the validator's own log file, and the journal entries
// of its systemd unit: what the start script printed before the validator opened its own log,
// which is where a start-up failure shows.

local.file_match "validator" {
  path_targets = [{
    __path__ = "{{ alloy_validator_log }}",
    job      = "solana-validator",
    node     = "{{ inventory_hostname }}",
    role     = "{{ solana_role }}",
  }]
}

loki.source.file "validator" {
  targets    = local.file_match.validator.targets
  forward_to = [loki.process.validator.receiver]
}

// Line format: [2026-10-08T09:51:17.476199302Z INFO  agave_validator::commands::run] message
// Only the level becomes a label. The module stays in the text: there are hundreds of them, and
// every label value is a separate stream in Loki.
loki.process "validator" {
  stage.regex {
    expression = "^\\[(?P<ts>\\S+)\\s+(?P<level>[A-Z]+)\\s"
  }

  stage.labels {
    values = { level = "level" }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  // Keep every warning and error; sample the routine lines. Measured on this cluster: about
  // 590 INFO lines per second across three nodes against 11 WARN and 0.02 ERROR. The lines that
  // explain an incident are the rare ones, so those are never dropped.
  stage.match {
    selector = "{level=\"INFO\"}"

    stage.sampling {
      rate = {{ alloy_info_sample_rate }}
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "sol" {
  matches       = "_SYSTEMD_UNIT=sol.service"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "systemd", node = "{{ inventory_hostname }}", role = "{{ solana_role }}" }
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "{{ alloy_loki_url }}"
  }
}

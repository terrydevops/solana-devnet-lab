          }
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "Layer 3: funds. Can we still pay for votes?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 23,
      "type": "timeseries",

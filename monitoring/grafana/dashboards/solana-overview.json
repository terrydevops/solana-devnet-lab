{
  "uid": "solana-overview",
  "title": "Solana cluster overview",
  "tags": [
    "solana"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Operator view: who runs the stake, what is left to pay for votes, how each validator is doing",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Validators at a glance",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per validator identity. Runs on host: the machine that runs that identity right now; it changes in a failover. Identity SOL pays the vote fees. Spend/day is net: vote fees minus block revenue. Days left = balance / spend; 9999 means the balance is not falling. Vote acct SOL is the commission earned and not yet withdrawn. Credits compares with the best validator. Skip 1h is the share of leader slots without a block.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (nodekey, node) (label_replace(solana_node_identity, \"nodekey\", \"$1\", \"identity\", \"(.+)\") and on (nodekey) group by (nodekey) (solana_validator_last_vote))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max by (nodekey) (solana_validator_active_stake)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "max by (nodekey) (solana:validator_stake_share:ratio)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "max by (nodekey) (solana_validator_commission)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "E",
          "expr": "max by (nodekey) (label_replace(solana:identity_balance:sol, \"nodekey\", \"$1\", \"address\", \"(.+)\"))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "F",
          "expr": "max by (nodekey) (label_replace(-deriv(solana:identity_balance:sol[30m]) * 86400, \"nodekey\", \"$1\", \"address\", \"(.+)\"))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "G",
          "expr": "max by (nodekey) (label_replace(clamp_max(solana:identity_balance:sol / clamp_min(-deriv(solana:identity_balance:sol[30m]) * 86400, 0.000001), 9999), \"nodekey\", \"$1\", \"address\", \"(.+)\"))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "H",
          "expr": "max by (nodekey) (label_replace(solana_account_balance, \"votekey\", \"$1\", \"address\", \"(.+)\") * on (votekey) group_left (nodekey) group by (votekey, nodekey) (solana_validator_last_vote))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "I",
          "expr": "max by (nodekey) (solana:validator_vote_lag:slots)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "J",
          "expr": "max by (nodekey) (solana:validator_credits_ratio:10m)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "K",
          "expr": "max by (nodekey) (solana:validator_skip_rate:1h)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "L",
          "expr": "max by (nodekey) (solana_validator_delinquent)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "nodekey",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "pattern": "/^(Time.*|Value #A)$/"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "nodekey": "Validator identity",
              "node": "Runs on host",
              "Value #B": "Stake (SOL)",
              "Value #C": "Share",
              "Value #D": "Comm. %",
              "Value #E": "Identity SOL",
              "Value #F": "Spend/day",
              "Value #G": "Days left",
              "Value #H": "Vote acct SOL",
              "Value #I": "Vote lag",
              "Value #J": "Credits",
              "Value #K": "Skip 1h",
              "Value #L": "Delinq."
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Stake (SOL)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Comm. %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Identity SOL"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spend/day"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vote acct SOL"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vote lag"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Credits"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Skip 1h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Delinq."
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 3
                    },
                    {
                      "color": "green",
                      "value": 14
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Vote lag"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
